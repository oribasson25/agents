DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
APP_PASSWORD=changeme

# Required. Signs session tokens; without it every function makes up its own
# random key and nobody stays signed in across instances.
JWT_SECRET=
# Required. The crons (/api/cron/*, /api/wa/*) refuse every caller without it.
CRON_SECRET=

# The site's own address, e.g. https://www.8legs.world. Used for OAuth
# redirects and for the platform's calls to itself (tool runner, scraper).
# APP_URL=

# Tool code runs customers' Python. Run it in a separate Vercel project that
# holds no platform secrets (see tool-runner/README.md), then set both here.
# Without them, code runs in this project's own /api/run-tool.
# TOOL_RUNNER_URL=https://<tool-runner-project>.vercel.app
# TOOL_RUNNER_SECRET=

# Automations › Connections. Microsoft 365 needs an app registered in Microsoft
# Entra (see Documentation › Connections in the app). Gmail connections use the
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET the per-chatbot Gmail already uses.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Optional: the key connection tokens and linked WhatsApp keys are encrypted
# with. Defaults to one derived from JWT_SECRET; set it before you ever rotate
# JWT_SECRET, and never change it afterwards.
# CONNECTIONS_KEY=
