DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
APP_PASSWORD=changeme

# Automations › Connections. Microsoft 365 needs an app registered in Microsoft
# Entra (see Documentation › Connections in the app). Gmail connections use the
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET the per-chatbot Gmail already uses.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Optional: the key connection tokens are encrypted with. Defaults to one
# derived from JWT_SECRET; if you set it, never change it afterwards.
# CONNECTIONS_KEY=
