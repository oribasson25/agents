{
  "functions": {
    "api/scrape_browser.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/widget/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/run-tool", "destination": "/api/run_tool.py" },
    { "source": "/api/scrape", "destination": "/api/scrape.py" },
    { "source": "/api/scrape-browser", "destination": "/api/scrape_browser.js" },
    { "source": "/api/extract-file", "destination": "/api/extract_file.py" },
    { "source": "/", "destination": "/agentforge.html" }
  ]
}
