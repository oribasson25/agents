{
  "crons": [
    {
      "path": "/api/cron/crawl-all",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/crawl-all",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/wa/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/automations",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/scrape_browser.js": {
      "maxDuration": 30
    },
    "api/llm.js": {
      "maxDuration": 300
    },
    "api/agents/[id]/crawl.js": {
      "maxDuration": 300
    },
    "api/cron/crawl-all.js": {
      "maxDuration": 300
    },
    "api/whatsapp/webhook.js": {
      "maxDuration": 90
    },
    "api/agents/[id]/documents.js": {
      "maxDuration": 300
    },
    "api/documents/[docId].js": {
      "maxDuration": 300
    },
    "api/agents/[id]/files.js": {
      "maxDuration": 60
    },
    "api/github/webhook.js": {
      "maxDuration": 60
    },
    "api/wa/worker.mjs": {
      "maxDuration": 800
    },
    "api/wa/cron.js": {
      "maxDuration": 60
    },
    "api/admin/jarvis/group-knowledge.js": {
      "maxDuration": 800
    },
    "api/apps/[id]/files.js": {
      "maxDuration": 60
    },
    "api/app-run.js": {
      "maxDuration": 90
    },
    "api/cron/automations.js": {
      "maxDuration": 300
    },
    "api/hook/[key].js": {
      "maxDuration": 300
    },
    "api/automations/[id]/[action].js": {
      "maxDuration": 300
    },
    "api/agents/[id]/automations.js": {
      "maxDuration": 90
    },
    "api/automations/[id]/files.js": {
      "maxDuration": 60
    },
    "api/automations/[id]/index.js": {
      "maxDuration": 30
    },
    "api/run_tool.py": {
      "maxDuration": 120
    },
    "api/tool-run.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/agentforge.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(privacy|terms|privacy\\.html|terms\\.html|presentation\\.html)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/run-tool",
      "destination": "/api/run_tool.py"
    },
    {
      "source": "/api/scrape-browser",
      "destination": "/api/scrape_browser.js"
    },
    {
      "source": "/api/extract-file",
      "destination": "/api/extract_file.py"
    },
    {
      "source": "/api/gmail/auth",
      "destination": "/api/gmail/auth.js"
    },
    {
      "source": "/api/gmail/callback",
      "destination": "/api/gmail/callback.js"
    },
    {
      "source": "/api/gmail/status",
      "destination": "/api/gmail/status.js"
    },
    {
      "source": "/api/gmail/send",
      "destination": "/api/gmail/send.js"
    },
    {
      "source": "/api/gmail/disconnect",
      "destination": "/api/gmail/disconnect.js"
    },
    {
      "source": "/api/whatsapp/webhook",
      "destination": "/api/whatsapp/webhook.js"
    },
    {
      "source": "/api/whatsapp/test",
      "destination": "/api/whatsapp/test.js"
    },
    {
      "source": "/api/github/webhook",
      "destination": "/api/github/webhook.js"
    },
    {
      "source": "/api/wa/worker",
      "destination": "/api/wa/worker.mjs"
    },
    {
      "source": "/api/wa/cron",
      "destination": "/api/wa/cron.js"
    },
    {
      "source": "/a/:rest(.*)",
      "destination": "/api/app-serve?p=:rest"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/",
      "destination": "/agentforge.html"
    }
  ]
}
